{
  "name": "ai-audio-visual-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4617 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "build:wasm": "wasm-pack build crates/deck-dsp --target web --release --no-pack --out-dir ../../src/wasm --out-name deck_dsp && rm -f src/wasm/.gitignore && mkdir -p public/wasm && cp src/wasm/deck_dsp_bg.wasm public/wasm/",
    "demo:audio": "cargo run --release -p deck-cli -- demo-tracks --out demo-audio",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.30.3"
}
